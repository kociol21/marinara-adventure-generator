{
  "name": "marinara-adventure-generator",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "description": "Local web app that generates spoiler-free adventures for Marinara Engine",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @adv/web build",
    "start": "pnpm --filter @adv/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  }
}
